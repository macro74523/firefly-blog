---
import { Icon } from "astro-icon/components";
import { analyticsConfig, commentConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getCategoryUrl, getTagUrl } from "@/utils/url-utils";

export interface Props {
	published: Date;
	updated?: Date;
	category?: string;
	tags?: string[];
	hideUpdateDate?: boolean;
	hideTagsForMobile?: boolean;
	isHome?: boolean;
	className?: string;
	id?: string;
	showPublished?: boolean;
	showCategory?: boolean;
	showTags?: boolean;
	maxTags?: number;
	showNoTags?: boolean;
	customPath?: string;
	pinned?: boolean;
	password?: boolean;
	words?: number;
	minutes?: number;
	showWords?: boolean;
	showReadingTime?: boolean;
	variant?: "default" | "cover";
	postUrl?: string;
}

const {
	published,
	updated,
	category,
	tags,
	hideUpdateDate,
	hideTagsForMobile,
	isHome,
	className = "",
	id,
	showPublished = true,
	showCategory = true,
	showTags = true,
	maxTags,
	showNoTags = true,
	customPath,
	pinned,
	words,
	minutes,
	showWords = false,
	showReadingTime = false,
	password,
	variant = "default",
	postUrl,
} = Astro.props;

const path = customPath || (id ? `/posts/${id}` : "");
const visibleTags =
	typeof maxTags === "number" ? tags?.slice(0, maxTags) : tags;

// Umami 浏览量配置
const umamiCfg = analyticsConfig.umamiAnalytics;
const showUmamiViews = !!umamiCfg?.shareId && !!postUrl;
const umamiShareId = umamiCfg?.shareId || "";
const umamiApiBase =
	umamiCfg?.shareApiBase ||
	(umamiCfg?.scriptUrl ? new URL(umamiCfg.scriptUrl).origin : "");
---

<div
  class:list={[
    "post-meta-root flex flex-wrap items-center gap-4 gap-x-4 gap-y-2",
    {
      "text-neutral-500 dark:text-neutral-400": variant === "default",
      "post-meta-cover text-white/90": variant === "cover",
    },
    className,
  ]}
>
  {
    pinned && (
      <div class="pinned-btn flex items-center gap-1 bg-(--btn-regular-bg) text-(--btn-content) rounded-md px-2 py-1.5 font-bold">
        <Icon is:inline name="material-symbols:pinboard" class="text-xl" />
        <span class="text-sm">{i18n(I18nKey.pinned)}</span>
      </div>
    )
  }

  {
    showPublished && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon
            is:inline
            name="material-symbols:calendar-today-outline-rounded"
            class="text-xl"
          />
        </div>
        <span class="text-50 text-sm font-medium">
          {formatDateToYYYYMMDD(published)}
        </span>
      </div>
    )
  }

  {
    showPublished &&
      !hideUpdateDate &&
      updated &&
      updated.getTime() !== published.getTime() && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon
              is:inline
              name="material-symbols:edit-calendar-outline-rounded"
              class="text-xl"
            />
          </div>
          <span class="text-50 text-sm font-medium">
            {formatDateToYYYYMMDD(updated)}
          </span>
        </div>
      )
  }

  {
    showCategory && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon is:inline name="material-symbols:book-2-outline-rounded" class="text-xl" />
        </div>
        <div class="flex flex-row flex-nowrap items-center">
          <a
            href={getCategoryUrl(category || "")}
            aria-label={`View all posts in the ${category} category`}
            class="link-lg transition text-50 text-sm font-medium
              hover:text-(--primary) dark:hover:text-(--primary) whitespace-nowrap"
          >
            {category || i18n(I18nKey.uncategorized)}
          </a>
        </div>
      </div>
    )
  }

  {
    showTags && (
      <div
        class:list={[
          "post-meta-tags items-center",
          { flex: !hideTagsForMobile, "hidden md:flex": hideTagsForMobile },
        ]}
      >
        <div class="meta-icon">
          <Icon is:inline name="material-symbols:tag-rounded" class="text-xl" />
        </div>
        <div class="flex flex-row flex-nowrap items-center">
          {visibleTags &&
            visibleTags.length > 0 &&
            visibleTags.map((tag, i) => (
              <>
                <div
                  class:list={[
                    { hidden: i === 0 },
                    "meta-divider mx-1.5 text-(--meta-divider) text-sm",
                  ]}
                >
                  /
                </div>
                <a
                  href={getTagUrl(tag)}
                  aria-label={`View all posts with the ${tag.trim()} tag`}
                  class="link-lg transition text-50 text-sm font-medium
                    hover:text-(--primary) dark:hover:text-(--primary) whitespace-nowrap"
                >
                  {tag.trim()}
                </a>
              </>
            ))}
          {showNoTags && !(visibleTags && visibleTags.length > 0) && (
            <div class="transition text-50 text-sm font-medium">
              {i18n(I18nKey.noTags)}
            </div>
          )}
        </div>
      </div>
    )
  }

  {
    !isHome &&
      commentConfig.type === "twikoo" &&
      commentConfig.twikoo?.visitorCount &&
      id && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon
              is:inline
              name="material-symbols:visibility-outline-rounded"
              class="text-xl"
            />
          </div>
          <span class="text-50 text-sm font-medium mr-1">
            {i18n(I18nKey.pageViews)}
          </span>
          <span class="text-50 text-sm font-medium" id="twikoo_visitors">
            {i18n(I18nKey.pageViewsLoading)}
          </span>
        </div>
      )
  }

  {
    !isHome &&
      commentConfig.type === "waline" &&
      commentConfig.waline?.visitorCount &&
      id && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon
              is:inline
              name="material-symbols:visibility-outline-rounded"
              class="text-xl"
            />
          </div>
          <span class="text-50 text-sm font-medium mr-1">
            {i18n(I18nKey.pageViews)}
          </span>
          <span
            class="text-50 text-sm font-medium waline-pageview-count"
            data-path={path}
          >
            {i18n(I18nKey.pageViewsLoading)}
          </span>
        </div>
      )
  }

  {
    !isHome &&
      commentConfig.type === "artalk" &&
      commentConfig.artalk?.visitorCount &&
      id && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon
              is:inline
              name="material-symbols:visibility-outline-rounded"
              class="text-xl"
            />
          </div>
          <span class="text-50 text-sm font-medium mr-1">
            {i18n(I18nKey.pageViews)}
          </span>
          <span
            class="text-50 text-sm font-medium artalk-pv-count"
            data-path={path}
          >
            {i18n(I18nKey.pageViewsLoading)}
          </span>
        </div>
      )
  }

  {
    showWords && typeof words === "number" && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon is:inline name="material-symbols:notes-rounded" class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium">
          {words} {i18n(words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
        </span>
      </div>
    )
  }

  {
    showReadingTime && typeof minutes === "number" && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon is:inline name="material-symbols:schedule-outline-rounded" class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium">
          {minutes} {i18n(minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
        </span>
      </div>
    )
  }

  {
    password && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon is:inline name="material-symbols:lock-outline" class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium">
          {i18n(I18nKey.postEncrypted)}
        </span>
      </div>
    )
  }

  <!-- Umami 浏览量 -->
  {
    showUmamiViews && (
      <div
        class="flex items-center"
        data-umami-pv-path={postUrl}
        data-umami-share-id={umamiShareId}
        data-umami-api-base={umamiApiBase}
      >
        <div class="meta-icon">
          <Icon is:inline name="material-symbols:visibility-outline-rounded" class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium mr-1">
          {i18n(I18nKey.pageViews)}
        </span>
        <span class="text-50 text-sm font-medium" data-umami-pv-value>
          {i18n(I18nKey.pageViewsLoading)}
        </span>
      </div>
    )
  }
</div>

<style>
  .post-meta-cover .text-50,
  .post-meta-cover .meta-divider {
    color: rgb(255 255 255 / 0.9) !important;
  }

  .post-meta-cover .meta-icon {
    width: 1.125rem;
    height: 1.125rem;
    margin-right: 0.375rem;
    background: transparent;
    color: rgb(255 255 255 / 0.9);
  }

  .post-meta-cover .text-sm {
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .post-meta-cover .text-xl {
    font-size: 1rem;
  }

  .post-meta-cover .post-meta-tags {
    min-width: 0;
  }

  .post-meta-cover .post-meta-tags .flex-nowrap {
    flex-wrap: wrap !important;
  }

  .post-meta-cover a:hover {
    color: white !important;
  }

  .post-meta-cover a:hover::before {
    background-color: rgb(255 255 255 / 0.18) !important;
  }

  .post-meta-cover a:active::before {
    background-color: rgb(255 255 255 / 0.26) !important;
  }

  @media (max-width: 767px) {
    .post-meta-cover .post-meta-tags {
      width: 100%;
    }
  }
</style>

<script>
  const SHARE_CACHE_KEY = "umami-profile-share";
  const SHARE_CACHE_TTL = 24 * 60 * 60 * 1000;
  const METRICS_CACHE_KEY = "umami-pv-metrics";
  const METRICS_CACHE_TTL = 5 * 60 * 1000;

  type ShareResponse = { token: string; websiteId: string };
  type MetricRow = { x: string; y: number };

  function readCache<T>(key: string, ttl: number, tag: string): T | null {
    const raw = localStorage.getItem(key);
    if (!raw) return null;
    try {
      const parsed = JSON.parse(raw);
      if (parsed && parsed.tag === tag && Date.now() - parsed.timestamp < ttl) {
        return parsed.value as T;
      }
    } catch {}
    localStorage.removeItem(key);
    return null;
  }

  function writeCache(key: string, tag: string, value: unknown) {
    try {
      localStorage.setItem(
        key,
        JSON.stringify({ timestamp: Date.now(), tag, value }),
      );
    } catch {}
  }

  async function getShare(apiBase: string, shareId: string): Promise<ShareResponse> {
    const cached = readCache<ShareResponse>(SHARE_CACHE_KEY, SHARE_CACHE_TTL, shareId);
    if (cached) return cached;
    const resp = await fetch(`${apiBase}/api/share/${shareId}`);
    if (!resp.ok) throw new Error(`share ${resp.status}`);
    const data = (await resp.json()) as ShareResponse;
    writeCache(SHARE_CACHE_KEY, shareId, data);
    return data;
  }

  async function getMetrics(
    apiBase: string,
    share: ShareResponse,
  ): Promise<MetricRow[]> {
    const cached = readCache<MetricRow[]>(
      METRICS_CACHE_KEY,
      METRICS_CACHE_TTL,
      share.websiteId,
    );
    if (cached) return cached;
    const url = `${apiBase}/api/websites/${share.websiteId}/metrics?startAt=0&endAt=${Date.now()}&type=url&limit=1000`;
    const resp = await fetch(url, {
      headers: {
        "x-umami-share-token": share.token,
        "x-umami-share-context": "1",
      },
    });
    if (!resp.ok) throw new Error(`metrics ${resp.status}`);
    const data = (await resp.json()) as MetricRow[];
    writeCache(METRICS_CACHE_KEY, share.websiteId, data);
    return data;
  }

  function normalize(p: string): string {
    return p.replace(/\/+$/, "").toLowerCase();
  }

  function buildLookup(rows: MetricRow[]): Map<string, number> {
    const m = new Map<string, number>();
    for (const r of rows) {
      const key = normalize(r.x);
      m.set(key, (m.get(key) || 0) + (r.y || 0));
    }
    return m;
  }

  async function fillPostViews() {
    const nodes = document.querySelectorAll<HTMLElement>("[data-umami-pv-path]");
    if (nodes.length === 0) return;

    const first = nodes[0];
    const shareId = first.dataset.umamiShareId;
    const apiBase = (first.dataset.umamiApiBase || "").replace(/\/$/, "");
    if (!shareId || !apiBase) return;

    let lookup: Map<string, number> | null = null;
    try {
      const share = await getShare(apiBase, shareId);
      const metrics = await getMetrics(apiBase, share);
      lookup = buildLookup(metrics);
    } catch {
      lookup = null;
    }

    nodes.forEach((node) => {
      const value = node.querySelector<HTMLElement>("[data-umami-pv-value]");
      if (!value) return;
      if (!lookup) {
        value.textContent = "—";
        return;
      }
      const path = normalize(node.dataset.umamiPvPath || "");
      const count = lookup.get(path) ?? 0;
      value.textContent = count.toLocaleString("en-US");
    });
  }

  function run() {
    requestAnimationFrame(() => fillPostViews());
  }
  run();
  document.addEventListener("swup:contentReplaced", run);
  document.addEventListener("astro:page-load", run);
</script>
