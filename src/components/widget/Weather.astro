---
interface Props {
	class?: string;
	style?: string;
	// 城市名称（中文或英文），用于自动获取经纬度
	city?: string;
	// 直接指定经纬度（优先级高于 city）
	latitude?: number;
	longitude?: number;
	// 显示名称（使用经纬度时建议填写，否则显示空）
	displayName?: string;
	// 时区，默认 Asia/Shanghai
	timezone?: string;
	// 是否根据访问者地理位置自动定位（需用户授权），失败时回退到已配置的城市
	autoLocate?: boolean;
}

const { class: className, style, city = "", latitude, longitude, displayName = "", timezone = "Asia/Shanghai", autoLocate = false } = Astro.props;
---

<div
	id="weather-widget"
	class:list={["card-base flex flex-col relative overflow-hidden", className]}
	style={style}
	data-city={city}
	data-lat={latitude?.toString() ?? ""}
	data-lon={longitude?.toString() ?? ""}
	data-display-name={displayName}
	data-tz={timezone}
	data-auto-locate={autoLocate ? "true" : "false"}
>
	<div class="px-5 pt-4 pb-3 flex items-center justify-between">
		<div class="flex items-center gap-1.5">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-(--primary)">
				<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
				<circle cx="12" cy="10" r="3"/>
			</svg>
			<span class="text-sm font-bold text-neutral-700 dark:text-neutral-300 weather-location">正在加载...</span>
		</div>
		<span class="text-xs opacity-50 text-neutral-700 dark:text-neutral-300 weather-update">--:--</span>
	</div>

	<div class="px-5 pb-4 flex items-center gap-4">
		<div class="flex-shrink-0 weather-icon-wrapper">
			<div class="weather-icon weather-icon-loading text-neutral-700 dark:text-neutral-300">
				<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="animate-spin opacity-30">
					<path d="M21 12a9 9 0 1 1-6.219-8.56"/>
				</svg>
			</div>
		</div>
		<div class="flex-1 min-w-0">
			<div class="flex items-baseline gap-2 text-neutral-800 dark:text-neutral-100">
				<span class="text-4xl font-bold font-mono weather-temp">--</span>
				<span class="text-lg font-bold opacity-60">°C</span>
			</div>
			<span class="text-sm font-bold opacity-70 text-neutral-700 dark:text-neutral-300 weather-condition">---</span>
		</div>
	</div>

	<div class="px-5 pb-4 flex items-center justify-between text-xs opacity-70 text-neutral-700 dark:text-neutral-300">
		<div class="flex items-center gap-1">
			<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/>
				<path d="M9.6 4.6A2 2 0 1 1 11 8H2"/>
				<path d="M12.6 19.4A2 2 0 1 0 14 16H2"/>
			</svg>
			<span class="weather-wind">--</span>
		</div>
		<div class="flex items-center gap-1">
			<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
			</svg>
			<span class="weather-humidity">--</span>
		</div>
	</div>
</div>

<script is:inline>
(() => {
	// Weather code mapping for Open-Meteo
	const weatherCodeMap = {
		0: { label: '晴', icon: 'sunny' },
		1: { label: '大部晴朗', icon: 'partly-cloudy' },
		2: { label: '多云', icon: 'partly-cloudy' },
		3: { label: '阴', icon: 'cloudy' },
		45: { label: '雾', icon: 'fog' },
		48: { label: '雾凇', icon: 'fog' },
		51: { label: '小毛毛雨', icon: 'drizzle' },
		53: { label: '中毛毛雨', icon: 'drizzle' },
		55: { label: '大毛毛雨', icon: 'drizzle' },
		56: { label: '冻毛毛雨', icon: 'drizzle' },
		57: { label: '冻毛毛雨', icon: 'drizzle' },
		61: { label: '小雨', icon: 'rain' },
		63: { label: '中雨', icon: 'rain' },
		65: { label: '大雨', icon: 'rain' },
		66: { label: '冻雨', icon: 'rain' },
		67: { label: '冻雨', icon: 'rain' },
		71: { label: '小雪', icon: 'snow' },
		73: { label: '中雪', icon: 'snow' },
		75: { label: '大雪', icon: 'snow' },
		77: { label: '雪粒', icon: 'snow' },
		80: { label: '阵雨', icon: 'rain' },
		81: { label: '阵雨', icon: 'rain' },
		82: { label: '暴雨', icon: 'rain' },
		85: { label: '阵雪', icon: 'snow' },
		86: { label: '阵雪', icon: 'snow' },
		95: { label: '雷暴', icon: 'thunder' },
		96: { label: '雷暴伴冰雹', icon: 'thunder' },
		99: { label: '强雷暴', icon: 'thunder' },
	};

	// Wind direction mapping
	const windDirMap = ['北', '东北', '东', '东南', '南', '西南', '西', '西北'];

	// SVG icons for weather conditions
	const weatherIcons = {
		sunny: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#FFB300" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" fill="#FFD54F"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>`,
		'partly-cloudy': `<svg width="48" height="48" viewBox="0 0 24 24" fill="none"><circle cx="8" cy="8" r="3.5" fill="#FFD54F" stroke="#FFB300" stroke-width="1"/><path d="M6 18a4 4 0 0 1 0-8 5 5 0 0 1 9.584-1.5 4 4 0 1 1 .376 8.5H6z" fill="#B0BEC5" stroke="#78909C" stroke-width="0.5"/></svg>`,
		cloudy: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M6 18a4 4 0 0 1 0-8 5 5 0 0 1 9.584-1.5 4 4 0 1 1 .376 8.5H6z" fill="#B0BEC5" stroke="#78909C" stroke-width="0.5"/></svg>`,
		fog: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M6 16a3 3 0 0 1 0-6 4 4 0 0 1 7.18-1.1A3.5 3.5 0 1 1 14 16H6z" fill="#CFD8DC" stroke="#90A4AE" stroke-width="0.5"/><line x1="4" y1="19" x2="20" y2="19" stroke="#90A4AE" stroke-width="1.5" stroke-linecap="round"/><line x1="6" y1="21.5" x2="18" y2="21.5" stroke="#90A4AE" stroke-width="1.5" stroke-linecap="round"/></svg>`,
		drizzle: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M6 14a4 4 0 0 1 0-8 5 5 0 0 1 9.584-1.5 4 4 0 1 1 .376 8.5H6z" fill="#B0BEC5" stroke="#78909C" stroke-width="0.5"/><line x1="8" y1="17" x2="7" y2="20" stroke="#4FC3F7" stroke-width="1.5" stroke-linecap="round"/><line x1="12" y1="17" x2="11" y2="20" stroke="#4FC3F7" stroke-width="1.5" stroke-linecap="round"/><line x1="16" y1="17" x2="15" y2="20" stroke="#4FC3F7" stroke-width="1.5" stroke-linecap="round"/></svg>`,
		rain: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M6 14a4 4 0 0 1 0-8 5 5 0 0 1 9.584-1.5 4 4 0 1 1 .376 8.5H6z" fill="#90A4AE" stroke="#607D8B" stroke-width="0.5"/><line x1="8" y1="17" x2="7" y2="21" stroke="#29B6F6" stroke-width="1.5" stroke-linecap="round"/><line x1="12" y1="17" x2="11" y2="21" stroke="#29B6F6" stroke-width="1.5" stroke-linecap="round"/><line x1="16" y1="17" x2="15" y2="21" stroke="#29B6F6" stroke-width="1.5" stroke-linecap="round"/></svg>`,
		snow: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M6 14a4 4 0 0 1 0-8 5 5 0 0 1 9.584-1.5 4 4 0 1 1 .376 8.5H6z" fill="#E0E0E0" stroke="#BDBDBD" stroke-width="0.5"/><circle cx="8" cy="18" r="0.8" fill="#81D4FA"/><circle cx="12" cy="20" r="0.8" fill="#81D4FA"/><circle cx="16" cy="18" r="0.8" fill="#81D4FA"/><circle cx="10" cy="21" r="0.8" fill="#81D4FA"/><circle cx="14" cy="21" r="0.8" fill="#81D4FA"/></svg>`,
		thunder: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M6 14a4 4 0 0 1 0-8 5 5 0 0 1 9.584-1.5 4 4 0 1 1 .376 8.5H6z" fill="#78909C" stroke="#546E7A" stroke-width="0.5"/><path d="M13 15l-3 5h3l-2 4 5-6h-3l2-3z" fill="#FFD54F" stroke="#F9A825" stroke-width="0.5" stroke-linejoin="round"/></svg>`,
	};

	const config = {
		city: "",
		latitude: null,
		longitude: null,
		displayName: "",
		timezone: "Asia/Shanghai",
		autoLocate: false,
	};

	function getCookie(name) {
		const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
		return match ? match[2] : null;
	}

	function setCookie(name, value, days) {
		const expires = new Date(Date.now() + days * 864e5).toUTCString();
		document.cookie = name + '=' + value + '; expires=' + expires + '; path=/';
	}

	function getWeatherIcon(iconType) {
		return weatherIcons[iconType] || weatherIcons.cloudy;
	}

	function getWindDirectionLabel(directionDeg) {
		const index = Math.round(directionDeg / 45) % 8;
		return windDirMap[index];
	}

	function updateWeatherUI(data) {
		const locationEl = document.querySelector('.weather-location');
		const updateEl = document.querySelector('.weather-update');
		const tempEl = document.querySelector('.weather-temp');
		const condEl = document.querySelector('.weather-condition');
		const windEl = document.querySelector('.weather-wind');
		const humidityEl = document.querySelector('.weather-humidity');
		const iconEl = document.querySelector('.weather-icon');

		if (!locationEl) return;

		const { current, location } = data;
		const weatherInfo = weatherCodeMap[current.weather_code] || { label: '未知', icon: 'cloudy' };

		locationEl.textContent = location?.name || config.displayName || config.city || '';
		const timeStr = current.time.split('T')[1] || '';
		updateEl.textContent = '更新于 ' + timeStr;
		tempEl.textContent = Math.round(current.temperature_2m);
		condEl.textContent = weatherInfo.label;
		windEl.textContent = getWindDirectionLabel(current.wind_direction_10m) + '风 ' + Math.round(current.wind_speed_10m) + ' km/h';
		humidityEl.textContent = '湿度 ' + current.relative_humidity_2m + '%';

		iconEl.innerHTML = getWeatherIcon(weatherInfo.icon);
	}

	async function reverseGeocode(lat, lon) {
		try {
			const resp = await fetch(
				'https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=' + lat + '&longitude=' + lon + '&localityLanguage=zh'
			);
			if (!resp.ok) throw new Error('Reverse geocode failed');
			const data = await resp.json();
			// 优先使用城市名，其次使用行政区名
			return data.city || data.locality || data.principalSubdivision || data.countryName || '';
		} catch (e) {
			return '';
		}
	}

	async function fetchWeather(overrideLat, overrideLon, overrideName) {
		try {
			let lat = overrideLat !== undefined ? overrideLat : config.latitude;
			let lon = overrideLon !== undefined ? overrideLon : config.longitude;
			let cityName = overrideName !== undefined ? overrideName : config.city;

			// If no coordinates, try to geocode the city name
			if (lat === null || lon === null) {
				const cached = getCookie('weather_geo');
				if (cached) {
					try {
						const geo = JSON.parse(decodeURIComponent(cached));
						lat = geo.lat;
						lon = geo.lon;
						cityName = geo.name;
					} catch (e) {}
				}

				if (lat === null || lon === null) {
					const geoResp = await fetch(
						'https://geocoding-api.open-meteo.com/v1/search?name=' + encodeURIComponent(cityName) + '&count=1&language=zh&format=json'
					);
					if (!geoResp.ok) throw new Error('Geocoding failed');
					const geoData = await geoResp.json();
					if (!geoData.results || geoData.results.length === 0) throw new Error('City not found');
					const geo = geoData.results[0];
					lat = geo.latitude;
					lon = geo.longitude;
					cityName = geo.name;
					setCookie('weather_geo', encodeURIComponent(JSON.stringify({ lat, lon, name: cityName })), 7);
				}
			}

			const weatherResp = await fetch(
				'https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon +
				'&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,wind_direction_10m' +
				'&timezone=' + encodeURIComponent(config.timezone)
			);
			if (!weatherResp.ok) throw new Error('Weather API failed');
			const weatherData = await weatherResp.json();

			// Merge geocoded name if we have it
			if (cityName) {
				weatherData.location = { name: cityName };
			}

			updateWeatherUI(weatherData);
		} catch (error) {
			console.warn('Weather fetch failed:', error);
			const locationEl = document.querySelector('.weather-location');
			if (locationEl) {
				locationEl.textContent = '天气加载失败';
			}
		}
	}

	function getVisitorLocation() {
		return new Promise((resolve) => {
			if (!navigator.geolocation) {
				resolve(null);
				return;
			}
			// 超时 8 秒后回退到默认城市
			const timer = setTimeout(() => resolve(null), 8000);
			navigator.geolocation.getCurrentPosition(
				(pos) => {
					clearTimeout(timer);
					resolve({ lat: pos.coords.latitude, lon: pos.coords.longitude });
				},
				() => {
					clearTimeout(timer);
					resolve(null);
				},
				{ timeout: 8000, maximumAge: 600000 }
			);
		});
	}

	async function initWeather() {
		// Read config from the element's data attributes
		const widget = document.getElementById('weather-widget');
		if (!widget) return;

		const widgetConfig = {
			city: widget.dataset.city || config.city,
			latitude: widget.dataset.lat ? parseFloat(widget.dataset.lat) : config.latitude,
			longitude: widget.dataset.lon ? parseFloat(widget.dataset.lon) : config.longitude,
			displayName: widget.dataset.displayName || config.displayName,
			timezone: widget.dataset.tz || config.timezone,
			autoLocate: widget.dataset.autoLocate === 'true',
		};

		Object.assign(config, widgetConfig);

		// 自动定位模式：尝试获取访问者位置
		if (config.autoLocate) {
			// 优先使用缓存的定位结果（30 分钟内）
			const cachedLoc = getCookie('weather_autoloc');
			if (cachedLoc) {
				try {
					const loc = JSON.parse(decodeURIComponent(cachedLoc));
					fetchWeather(loc.lat, loc.lon, loc.name);
					return;
				} catch (e) {}
			}

			const position = await getVisitorLocation();
			if (position) {
				// 反向地理编码获取城市名
				const cityName = await reverseGeocode(position.lat, position.lon);
				// 缓存定位结果 30 分钟
				setCookie('weather_autoloc', encodeURIComponent(JSON.stringify({ lat: position.lat, lon: position.lon, name: cityName })), 1 / 48);
				fetchWeather(position.lat, position.lon, cityName);
				return;
			}
			// 定位失败/被拒绝 → 回退到默认城市
		}

		// 检查是否有经纬度或城市名
		const hasCoords = config.latitude !== null && config.longitude !== null && !isNaN(config.latitude);
		if (hasCoords || config.city) {
			fetchWeather();
		} else {
			const locationEl = document.querySelector('.weather-location');
			if (locationEl) {
				locationEl.textContent = '未配置城市';
			}
		}
	}

	// Initialize
	initWeather();

	// Update every 30 minutes（使用缓存的定位结果刷新天气）
	setInterval(() => {
		if (config.autoLocate) {
			const cachedLoc = getCookie('weather_autoloc');
			if (cachedLoc) {
				try {
					const loc = JSON.parse(decodeURIComponent(cachedLoc));
					fetchWeather(loc.lat, loc.lon, loc.name);
					return;
				} catch (e) {}
			}
		}
		fetchWeather();
	}, 30 * 60 * 1000);

	document.addEventListener("swup:contentReplaced", () => {
		initWeather();
	});
})();
</script>

<style>
	.weather-icon-loading {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
	}
</style>
