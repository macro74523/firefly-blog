---
import WidgetLayout from "@/components/common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
---

<WidgetLayout id="schedule-widget" class={className} style={style}>
  <div class="schedule-container">
    <div class="holiday-section text-center">
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-1 nearest-holiday-full">距离 --</p>
      <p class="text-3xl font-bold text-(--primary) leading-tight nearest-holiday-days">--</p>
    </div>
  </div>
</WidgetLayout>

<script is:inline>
  (function () {
    const holidays = [
      { name: "元旦", month: 0, day: 1 },
      { name: "清明", month: 3, day: 4 },
      { name: "劳动节", month: 4, day: 1 },
      { name: "端午", month: 5, day: 19 },
      { name: "中秋", month: 8, day: 25 },
      { name: "国庆", month: 9, day: 1 },
    ];

    const getNearestHoliday = (now) => {
      const year = now.getFullYear();
      const dates = holidays
        .map((holiday) => ({
          name: holiday.name,
          date: new Date(year, holiday.month, holiday.day),
        }))
        .concat({ name: "元旦", date: new Date(year + 1, 0, 1) })
        .filter((holiday) => holiday.date >= now)
        .sort((a, b) => a.date - b.date);

      const nearest = dates[0];
      const days = Math.ceil((nearest.date - now) / 86400000);
      return {
        name: nearest.name,
        days: days === 0 ? "今天" : `${days}天`,
      };
    };

    const setText = (container, selector, value) => {
      const element = container.querySelector(selector);
      if (element) element.textContent = value;
    };

    const updateSchedule = () => {
      const now = new Date();
      const nearestHoliday = getNearestHoliday(now);

      document.querySelectorAll(".schedule-container").forEach((container) => {
        setText(container, ".nearest-holiday-full", `距离${nearestHoliday.name}`);
        setText(container, ".nearest-holiday-days", nearestHoliday.days);
      });
    };

    const initSchedule = () => {
      updateSchedule();
      const now = new Date();
      const nextDay = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
      setTimeout(() => {
        updateSchedule();
        setInterval(updateSchedule, 86400000);
      }, nextDay - now);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSchedule, { once: true });
    } else {
      initSchedule();
    }

    document.addEventListener("astro:page-load", updateSchedule);
  })();
</script>

<style>
  .schedule-container {
    padding: 0;
  }
</style>
